# ═══════════════════════════════════════════════════════════
# CORVUS X — 환경변수 설정
# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
# ═══════════════════════════════════════════════════════════

# === AI Provider API Keys (필수) ===
OPENAI_API_KEY=sk-...              # OpenAI API 키
ANTHROPIC_API_KEY=sk-ant-...       # Anthropic Claude API 키
GEMINI_API_KEY=AI...               # Google Gemini API 키
PERPLEXITY_API_KEY=pplx-...        # Perplexity API 키

# === Image/Video Generation (선택) ===
MIDJOURNEY_API_KEY=
MIDJOURNEY_DISCORD_TOKEN=
MIDJOURNEY_CHANNEL_ID=
RUNWAY_API_KEY=

# === Server Configuration ===
PORT=8000                          # 서버 포트 (기본: 8000)
NODE_ENV=development               # development | staging | production
ADMIN_API_TOKEN=                   # API 인증 토큰 (빈값 = localhost만 허용)

# === 단일 유저 비밀번호 로그인 (공개 배포용) ===
# 둘 중 하나만 설정. HASH 방식 권장.
# 해시 생성: node deploy/scripts/generate-password-hash.mjs <비밀번호>
# 형식: scrypt$<N>$<saltHex>$<hashHex>
CORVUS_ACCESS_PASSWORD_HASH=
# 평문 비밀번호 (단순 테스트용, 프로덕션 비권장)
CORVUS_ACCESS_PASSWORD=
# 세션 쿠키 서명 시크릿 (32바이트 이상 랜덤 추천)
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CORVUS_SESSION_SECRET=
# 세션 쿠키 Secure 플래그 (auto | true | false)
# auto: NODE_ENV=production 이면 true
CORVUS_COOKIE_SECURE=auto
# 세션 쿠키 Domain (빈값 = 현재 호스트, 예: .cloudcookie.co.kr)
CORVUS_COOKIE_DOMAIN=

# === CORS ===
CORS_ORIGINS=                      # 허용 도메인 (쉼표 구분, 빈값 = 전체 허용 "*")
                                   # 예: https://app.cloudcookie.co.kr

# === Database (CORVUS X 전용 — SQLite) ===
# ⚠️  CC HOMEPAGE 는 Supabase/PostgreSQL 사용 — 이 파일에 SUPABASE_* 변수 추가 금지
DB_PATH=server/data/corvus.db      # SQLite DB 파일 경로

# === Logging ===
LOG_LEVEL=info                     # debug | info | warn | error

# === Performance ===
COMPRESSION_ENABLED=               # 응답 gzip 압축 (빈값 = 환경별 기본값)
                                   # development: false, staging/production: true

# === AI Judge (선택) ===
# ENABLE_AI_JUDGE=true
# GEMINI_JUDGE_MODEL=gemini-2.5-pro
# OPENAI_JUDGE_MODEL=gpt-5.2
# CLAUDE_JUDGE_MODEL=claude-opus-4-6

# === Frontend ===
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_TOKEN=
# VITE_LANG=ko
