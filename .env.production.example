# ═══════════════════════════════════════════════════════════
# CORVUS X — 프로덕션 환경변수 예시 (app.cloudcookie.co.kr)
#
# 실제 서버에서는 이 파일을 /etc/corvusx/.env 로 복사하고
# 아래 빈값들을 채워 넣으세요. 이 파일 자체는 .gitignore 대상입니다.
# ═══════════════════════════════════════════════════════════

# === AI Provider API Keys ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# === Image/Video Generation (선택) ===
MIDJOURNEY_API_KEY=
MIDJOURNEY_DISCORD_TOKEN=
MIDJOURNEY_CHANNEL_ID=
RUNWAY_API_KEY=

# === Server Configuration ===
PORT=8000
NODE_ENV=production
# ADMIN_API_TOKEN 은 CLI / curl 검증용 백도어.
# 프론트는 쿠키 로그인을 쓰므로 비워도 됨.
ADMIN_API_TOKEN=

# === 단일 유저 로그인 (Mr.T 전용) ===
# 1) 비밀번호 해시 생성 (서버 SSH 에서 실행):
#    cd /opt/corvusx && node deploy/scripts/generate-password-hash.mjs '원하는비밀번호'
# 2) 출력된 scrypt$... 문자열을 아래에 붙여넣기
CORVUS_ACCESS_PASSWORD_HASH=

# 세션 쿠키 서명 시크릿 (반드시 고유값. 노출되면 로그인 우회 가능)
# 생성: openssl rand -hex 48
CORVUS_SESSION_SECRET=

# production 이면 Secure 자동 적용. nginx 가 HTTPS 종료하므로 true 로 고정 가능.
CORVUS_COOKIE_SECURE=true

# 쿠키 도메인 — app 서브도메인에만 한정 (apex/www 로 새지 않음)
CORVUS_COOKIE_DOMAIN=app.cloudcookie.co.kr

# === CORS ===
# 프론트가 같은 오리진(app.cloudcookie.co.kr)에서 서빙되므로 동일 도메인만 허용
CORS_ORIGINS=https://app.cloudcookie.co.kr

# === Database ===
DB_PATH=/var/lib/corvusx/corvus.db

# === Logging ===
LOG_LEVEL=info

# === Performance ===
COMPRESSION_ENABLED=true
